<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Tour Gallery — Tutorials</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%# Pull the host app's tailwind build. Both hosts publish it as `tailwind`. %>
  <% if respond_to?(:stylesheet_link_tag) %>
    <%= stylesheet_link_tag "tailwind" rescue nil %>
  <% end %>

  <%# driver.js (CDN — same version the engine pins). %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/driver.js@1.4.0/dist/driver.css">

  <%# Host's importmap — gives us Stimulus + driver.js + the tutorials controller. %>
  <% if respond_to?(:javascript_importmap_tags) %>
    <%= javascript_importmap_tags rescue nil %>
  <% end %>
</head>
<body class="bg-gray-50 dark:bg-gray-950 text-gray-900 dark:text-gray-100 min-h-screen antialiased" style="font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', Roboto, sans-serif;">

  <%# Render the engine loader partial here so the gallery picks up the
      same Stimulus root + the engine's inline UI styling (driver.js
      popover overrides, launcher pill, dark-mode tokens). %>
  <%= render "tutorials/loader" %>

  <header class="border-b border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-5 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-lg bg-indigo-600 flex items-center justify-center text-white">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
            <circle cx="12" cy="12" r="10"/>
            <polygon points="10 8 16 12 10 16 10 8"/>
          </svg>
        </div>
        <div>
          <h1 class="text-base font-semibold leading-tight">Tour Gallery</h1>
          <p class="text-xs text-gray-500 dark:text-gray-400">Preview every registered tutorial</p>
        </div>
      </div>
      <a href="/" class="text-sm text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white">← Back to app</a>
    </div>
  </header>

  <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <% if @tours.empty? %>
      <div class="rounded-xl border border-dashed border-gray-300 dark:border-gray-700 p-12 text-center bg-white dark:bg-gray-900">
        <p class="text-sm text-gray-500 dark:text-gray-400">No tours registered yet.</p>
      </div>
    <% else %>
      <p class="text-sm text-gray-600 dark:text-gray-400 mb-6">
        Click <strong>Preview</strong> to launch a tour right here. Some steps may not highlight if their target elements don't exist on this page — that's expected.
      </p>

      <ul class="space-y-3">
        <% @tours.each do |tour| %>
          <% rendered = tour.render_for_locale(I18n.locale) %>
          <li class="group flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 p-5 hover:border-indigo-400 dark:hover:border-indigo-500 transition-colors">
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2 flex-wrap">
                <h2 class="text-base font-semibold text-gray-900 dark:text-white truncate">
                  <%= rendered[:title] %>
                </h2>
                <% if rendered[:first_login] %>
                  <span class="inline-flex items-center px-2 py-0.5 text-[10px] font-semibold rounded-full bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300 uppercase tracking-wider">First-login</span>
                <% end %>
                <span class="inline-flex items-center px-2 py-0.5 text-[10px] font-mono rounded bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300">
                  <%= tour.id %>
                </span>
              </div>
              <% if rendered[:description].present? %>
                <p class="mt-1 text-sm text-gray-600 dark:text-gray-400"><%= rendered[:description] %></p>
              <% end %>
              <dl class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-gray-500 dark:text-gray-400">
                <div class="flex items-center gap-1">
                  <span class="font-medium text-gray-700 dark:text-gray-300">Route:</span>
                  <code class="font-mono"><%= tour.route %></code>
                </div>
                <div class="flex items-center gap-1">
                  <span class="font-medium text-gray-700 dark:text-gray-300">Steps:</span>
                  <span><%= tour.steps.size %></span>
                </div>
              </dl>
            </div>

            <div class="flex items-center gap-2 shrink-0">
              <button type="button"
                      class="inline-flex items-center gap-1.5 px-3 py-2 text-sm font-medium rounded-lg bg-indigo-600 text-white hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors"
                      data-tour-id="<%= tour.id %>"
                      onclick="(function(btn){var root=document.querySelector('[data-controller~=&quot;tutorials&quot;]');if(!root){alert('Tutorials Stimulus controller not mounted on this page');return;}root.dispatchEvent(new CustomEvent('tutorials:open',{detail:{tourId:btn.dataset.tourId}}));})(this)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                  <polygon points="5 3 19 12 5 21 5 3"/>
                </svg>
                Preview
              </button>
              <a href="<%= tour.route %>"
                 class="inline-flex items-center gap-1.5 px-3 py-2 text-sm font-medium rounded-lg border border-gray-300 dark:border-gray-700 text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
                Visit page
              </a>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
  </main>
</body>
</html>
