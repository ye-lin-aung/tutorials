<%# Emits the Stimulus controller root once per layout, plus all engine
    UI overrides. We inline the CSS so the engine is fully self-contained
    in any host app — no asset-pipeline registration, no host stylesheet
    edits, no class collisions with the host's design system. %>
<div data-controller="tutorials"
     data-tutorials-available-value="<%= tutorials_available_ids.to_json %>"
     data-tutorials-auto-open-value="<%= tutorials_auto_open_id.to_s %>"
     class="hidden"
     aria-hidden="true">
</div>

<style>
  /* ═══════════════════════════════════════════════════════
     Tutorials engine — UI overrides (scoped, self-contained)
     ═══════════════════════════════════════════════════════ */

  :root {
    --t-color-primary:        #5e6ad2;
    --t-color-primary-hover:  #4e5bc2;
    --t-color-primary-fg:     #ffffff;
    --t-color-surface:        #ffffff;
    --t-color-surface-2:      #f6f7f9;
    --t-color-text:           #15171c;
    --t-color-text-soft:      #4b5160;
    --t-color-text-muted:     #8b8d98;
    --t-color-border:         #e5e7eb;
    --t-color-border-strong:  #d1d5db;
    --t-radius:               14px;
    --t-radius-sm:            10px;
    --t-shadow-soft:          0 1px 2px 0 rgb(0 0 0 / 0.04), 0 4px 14px -6px rgb(0 0 0 / 0.08);
    --t-shadow-lg:            0 10px 25px -5px rgb(0 0 0 / 0.15), 0 30px 60px -20px rgb(0 0 0 / 0.18);
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --t-color-surface:        #161821;
      --t-color-surface-2:      #1d1f2a;
      --t-color-text:           #f4f5f7;
      --t-color-text-soft:      #c1c4cb;
      --t-color-text-muted:     #8b8d98;
      --t-color-border:         #2a2d3a;
      --t-color-border-strong:  #353948;
    }
  }

  /* ── Launcher pill (rendered in host layouts) ───────────── */
  .tutorials-launcher {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.85rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1;
    color: var(--t-color-primary);
    background: rgba(94, 106, 210, 0.08);
    border: 1px solid rgba(94, 106, 210, 0.18);
    box-shadow: 0 1px 0 rgb(0 0 0 / 0.02);
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease, transform 0.05s ease;
    text-decoration: none;
  }
  .tutorials-launcher:hover {
    background: rgba(94, 106, 210, 0.14);
    border-color: rgba(94, 106, 210, 0.32);
  }
  .tutorials-launcher:active { transform: translateY(1px); }
  .tutorials-launcher svg { width: 14px; height: 14px; }
  .tutorials-launcher__pulse {
    width: 6px; height: 6px;
    border-radius: 9999px;
    background: var(--t-color-primary);
    box-shadow: 0 0 0 0 rgba(94, 106, 210, 0.45);
    animation: t-pulse 2s ease-out infinite;
    flex-shrink: 0;
  }
  @keyframes t-pulse {
    0%   { box-shadow: 0 0 0 0 rgba(94, 106, 210, 0.45); }
    70%  { box-shadow: 0 0 0 8px rgba(94, 106, 210, 0); }
    100% { box-shadow: 0 0 0 0 rgba(94, 106, 210, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .tutorials-launcher__pulse { animation: none; }
  }

  /* ── driver.js popover overrides ────────────────────────── */
  .driver-popover {
    background: var(--t-color-surface) !important;
    color: var(--t-color-text) !important;
    border: 1px solid var(--t-color-border) !important;
    border-radius: var(--t-radius) !important;
    box-shadow: var(--t-shadow-lg) !important;
    padding: 1.25rem 1.25rem 1rem !important;
    max-width: 380px !important;
    font-family: -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", Roboto, sans-serif;
  }
  .driver-popover-title {
    font-size: 1rem !important;
    font-weight: 700 !important;
    color: var(--t-color-text) !important;
    margin: 0 0 0.5rem !important;
    line-height: 1.35 !important;
    letter-spacing: -0.01em;
    padding-right: 1.5rem; /* room for the close button */
  }
  .driver-popover-description {
    font-size: 0.875rem !important;
    color: var(--t-color-text-soft) !important;
    line-height: 1.55 !important;
    margin: 0 0 1rem !important;
  }
  .driver-popover-footer {
    margin: 0.75rem -0.25rem -0.25rem !important;
    padding-top: 0.75rem !important;
    border-top: 1px solid var(--t-color-border) !important;
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 0.5rem !important;
  }
  .driver-popover-progress-text {
    font-size: 0.7rem !important;
    font-weight: 600 !important;
    color: var(--t-color-text-muted) !important;
    text-transform: uppercase !important;
    letter-spacing: 0.06em !important;
    padding: 0 0.25rem;
  }
  .driver-popover-navigation-btns {
    display: flex !important;
    gap: 0.4rem !important;
  }
  .driver-popover-prev-btn,
  .driver-popover-next-btn {
    appearance: none !important;
    border-radius: var(--t-radius-sm) !important;
    padding: 0.5rem 0.95rem !important;
    font-size: 0.8125rem !important;
    font-weight: 600 !important;
    line-height: 1 !important;
    cursor: pointer !important;
    transition: background 0.15s ease, border-color 0.15s ease, transform 0.05s ease, box-shadow 0.15s ease !important;
    text-shadow: none !important;
  }
  .driver-popover-prev-btn {
    background: var(--t-color-surface-2) !important;
    color: var(--t-color-text-soft) !important;
    border: 1px solid var(--t-color-border) !important;
  }
  .driver-popover-prev-btn:hover {
    background: var(--t-color-border) !important;
    color: var(--t-color-text) !important;
  }
  .driver-popover-next-btn {
    background: var(--t-color-primary) !important;
    color: var(--t-color-primary-fg) !important;
    border: 1px solid var(--t-color-primary) !important;
    box-shadow: 0 6px 16px -8px var(--t-color-primary) !important;
  }
  .driver-popover-next-btn:hover {
    background: var(--t-color-primary-hover) !important;
    border-color: var(--t-color-primary-hover) !important;
    box-shadow: 0 10px 22px -10px var(--t-color-primary) !important;
  }
  .driver-popover-prev-btn:active,
  .driver-popover-next-btn:active { transform: translateY(1px); }
  .driver-popover-close-btn {
    appearance: none !important;
    background: transparent !important;
    border: 0 !important;
    color: var(--t-color-text-muted) !important;
    width: 28px !important;
    height: 28px !important;
    border-radius: 8px !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    font-size: 18px !important;
    line-height: 1 !important;
    cursor: pointer !important;
    transition: background 0.15s ease, color 0.15s ease !important;
    top: 0.75rem !important;
    right: 0.75rem !important;
  }
  .driver-popover-close-btn:hover {
    background: var(--t-color-surface-2) !important;
    color: var(--t-color-text) !important;
  }

  .driver-popover-arrow {
    border-color: transparent !important;
  }
  .driver-popover-arrow.driver-popover-arrow-side-top    { border-top-color: var(--t-color-surface) !important; }
  .driver-popover-arrow.driver-popover-arrow-side-bottom { border-bottom-color: var(--t-color-surface) !important; }
  .driver-popover-arrow.driver-popover-arrow-side-left   { border-left-color: var(--t-color-surface) !important; }
  .driver-popover-arrow.driver-popover-arrow-side-right  { border-right-color: var(--t-color-surface) !important; }

  /* Highlighted element gets a softer focus ring than driver.js default */
  .driver-active-element,
  .driver-active-element:focus {
    outline: 3px solid var(--t-color-primary) !important;
    outline-offset: 4px !important;
    border-radius: 8px;
  }

  /* Slightly lighter overlay so highlighted elements feel less buried */
  .driver-overlay {
    opacity: 0.62 !important;
  }

  /* ── Subtle entrance animation ─────────────────────────── */
  .driver-popover {
    animation: t-popover-in 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes t-popover-in {
    0%   { opacity: 0; transform: translateY(6px) scale(0.98); }
    100% { opacity: 1; transform: translateY(0)   scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .driver-popover { animation: none; }
  }
</style>
