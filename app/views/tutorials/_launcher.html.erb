<% if any_tutorials_available? %>
  <button type="button"
          class="tutorials-launcher"
          data-action="click->tutorials#open"
          data-tutorials-tour-id-param="<%= tutorials_available_ids.first %>"
          aria-label="<%= t("tutorials.launcher.title", default: "Take a tour") %>"
          title="<%= t("tutorials.launcher.title", default: "Take a tour") %>">
    <span class="tutorials-launcher__pulse" aria-hidden="true"></span>
    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="10" cy="10" r="8"/>
      <polygon points="8 6 14 10 8 14 8 6" fill="currentColor" stroke="none"/>
    </svg>
    <%= t("tutorials.launcher.label", default: "Take a tour") %>
  </button>
<% end %>
